POSTGRES_USER=zoba
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=zoba
DATABASE_URL=postgresql+asyncpg://zoba:replace-with-a-strong-database-password@db:5432/zoba
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Browser origins allowed to call the API directly (comma-separated).
# The Vite dev server proxies /api same-origin, so this mainly matters for
# preview/production builds served from another origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
