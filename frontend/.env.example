# Copy to .env.local to override (git-ignored).
# See README.md → "Connecting to the real backend".

# mock    = in-browser demo data only (no server needed)
# hybrid  = real backend where implemented, mock elsewhere (default)
# real    = real backend only; unimplemented endpoints return 501
VITE_API_MODE=hybrid

# API base URL. Default /api/v1 is proxied to the FastAPI server in dev.
# For a preview/production build served from another origin, set the full URL,
# e.g. VITE_API_URL=https://api.example.com/api/v1 (and allow the frontend
# origin in the backend's CORS_ORIGINS).
# VITE_API_URL=/api/v1

# MapLibre style URL (defaults to OpenFreeMap "liberty"; needs internet).
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Reverse geocoder that fills the home-base address when the map is tapped
# (Nominatim-compatible /reverse endpoint; defaults to OSM's public instance).
# VITE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
